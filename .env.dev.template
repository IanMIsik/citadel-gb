# Copy to .env.dev and fill in. .env.dev is gitignored -- never commit real secrets.
#
# A dev instance is started with CITADEL_ENV_FILE=.env.dev (a real OS env
# var, set before the process starts -- see citadel/config.py), pointing it
# at its own database and, via `citadel serve --port`, its own port, so it
# runs alongside prod (which keeps reading plain .env) without either one
# touching the other's data or behaviour:
#
#   CITADEL_ENV_FILE=.env.dev citadel serve --port 8001 --reload
#
# The same FastAPI app serves the frontend too, so this is a complete dev
# instance -- open http://127.0.0.1:8001/ (pricing stack) and
# http://127.0.0.1:8001/fpn (FPN Analytics) directly, same as prod on 8000.
#
# Create the database once: CREATE DATABASE citadel_dev; (same Postgres
# instance/credentials as prod's docker-compose.yml is fine -- it's a
# separate database, not a separate server).
DATABASE_URL=postgresql://citadel:citadel@localhost:5432/citadel_dev

# Left blank on purpose: dev runs on REST polling alone (see
# rest_poll_interval_seconds below), so it doesn't compete with prod for
# the same IRIS queue. Fill these in only if you specifically need to test
# IRIS-related behaviour in dev -- ask for a second queue name first.
IRIS_TENANT_ID=4203b7a0-7773-4de5-b830-8b263a20426e
IRIS_NAMESPACE=elexon-insights-iris
IRIS_CLIENT_ID=
IRIS_CLIENT_SECRET=
IRIS_QUEUE_NAME=

REST_POLL_INTERVAL_SECONDS=5

# Free key from https://transparency.entsoe.eu/ -- only powers the Fundies
# dashboard's interconnector-flow rows/graphs; everything else on that
# page works without it (those rows just show "--").
ENTSOE_KEY=

# Shows a "DEV" badge in the frontend header so a browser tab is never
# mistaken for prod when both are open side by side.
ENVIRONMENT_LABEL=dev

# Feature toggles being validated in dev before they become prod's default
# -- see citadel/config.py's own docstring on each one.
REVERSAL_SIDE_FIX_ENABLED=false
FPN_OTHER_FALLBACK_ENABLED=true
DISBSAD_DISAGGREGATION_ENABLED=true
