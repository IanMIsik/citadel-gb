# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

DATABASE_URL=postgresql://citadel:citadel@localhost:5432/citadel

# IRIS (Elexon Insights Real-time Information Service) -- optional.
# Sign up yourself at https://bmrs.elexon.co.uk/iris to get these; Citadel
# runs fine on REST polling alone until they're set, then prefers IRIS
# automatically once all four are present.
IRIS_TENANT_ID=4203b7a0-7773-4de5-b830-8b263a20426e
IRIS_NAMESPACE=elexon-insights-iris
IRIS_CLIENT_ID=
IRIS_CLIENT_SECRET=
IRIS_QUEUE_NAME=

# Fallback/backfill REST poll interval, seconds. Only used for the datasets
# IRIS isn't covering yet (or at all, if IRIS creds are unset).
REST_POLL_INTERVAL_SECONDS=5
